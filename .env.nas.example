# ============================================================
# 旅行工具箱 NAS 部署环境变量
# 请将以下值替换为你的 Supabase 项目凭据
# 获取路径：Supabase 项目 → Settings → API
# ============================================================

# Supabase 项目 URL（必填）
COZE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key（必填）
COZE_SUPABASE_ANON_KEY=your-anon-key

# PostgreSQL 直连 URL（必填，用于建表和部分 API）
# 格式：postgresql://postgres:[YOUR-PASSWORD]@[HOST]:6543/postgres
PGDATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
